    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "All this blood, just to keep him standing.\nThe most dangerous piece,
    don't let him fool you.\nTo lead the people, walk behind them.\n\u201CWhen the
    board is empty and the Light dies, you will wish I had fallen sooner.\u201D"
